# Copy to .env (never commit .env). Vercel: add the same keys under Project Settings -> Environment Variables.

# OpenRouter (free models are discovered automatically; optionally pin your own list, comma-separated, best first)
OPENROUTER_API_KEY=
# OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,google/gemma-3-27b-it:free
# LLM_BUDGET_SECONDS=40

# Upstash Vector (recommended): HYBRID index, dense model OpenAI text-embedding-3-small (1536, COSINE) + sparse BM25.
# Upstash embeds the text and fuses dense + BM25. The index type is detected automatically; a custom Dense/384/COSINE
# index uses the self-hosted MiniLM instead.
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# EMBED_PROVIDER=auto                       # auto | upstash | upstash-hybrid | local
# UPSTASH_TIMEOUT=20
# Self-hosted embeddings (only for a custom index or no Upstash). ~220 MB, downloaded once to ./models or /tmp.
# EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# EMBED_MODEL_REPO=Qdrant/paraphrase-multilingual-MiniLM-L12-v2-onnx-Q

# API
# CORS_ORIGINS=https://your-ui.vercel.app
# RATE_LIMIT_PER_MINUTE=30
# CACHE_TTL_SECONDS=3600
# EVAL_TOKEN=pick-a-long-random-string     # enables POST /api/eval/run
# RAG_STORE=local                          # force keyword-only search (no embeddings)
